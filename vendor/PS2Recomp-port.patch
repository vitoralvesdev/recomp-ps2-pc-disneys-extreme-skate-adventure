+
+bool PS2AudioBackend::beginPcmStream(uint32_t sampleRate, uint32_t channels)
+{
+#if defined(PLATFORM_VITA)
+    (void)sampleRate;
+    (void)channels;
+    return false;
+#else
+    if (!m_audioReady || !IsAudioDeviceReady() || sampleRate == 0u || sampleRate > 192000u ||
+        (channels != 1u && channels != 2u))
+    {
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_impl->pcmStreamActive && m_impl->pcmSampleRate == sampleRate && m_impl->pcmChannels == channels)
+    {
+        return true;
+    }
+    stopPcmStreamUnlocked();
+    m_impl->pcmStream = LoadAudioStream(48000, 32, 2);
+    if (m_impl->pcmStream.buffer == nullptr || m_impl->pcmStream.sampleRate != 48000u)
+    {
+        return false;
+    }
+    m_impl->pcmSampleRate = sampleRate;
+    m_impl->pcmChannels = channels;
+    m_impl->pcmStreamActive = true;
+    g_pcmStreamBackend.store(this);
+    SetAudioStreamCallback(m_impl->pcmStream, &PS2AudioBackend::pcmStreamCallback);
+    PlayAudioStream(m_impl->pcmStream);
+    return true;
+#endif
+}
+
+bool PS2AudioBackend::appendPcmStream(const int16_t *pcm, uint32_t frameCount,
+                                      uint32_t sampleRate, uint32_t channels)
+{
+    if (!pcm || frameCount == 0u || sampleRate == 0u || sampleRate > 192000u ||
+        (channels != 1u && channels != 2u))
+    {
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_impl->pcmStreamActive || m_impl->pcmSampleRate != sampleRate || m_impl->pcmChannels != channels)
+    {
+        return false;
+    }
+
+    const uint32_t outputFrames = (static_cast<uint64_t>(frameCount) * 48000u + sampleRate / 2u) / sampleRate;
+    m_impl->pcmQueue.reserve(m_impl->pcmQueue.size() + static_cast<size_t>(outputFrames) * 2u);
+    for (uint32_t out = 0u; out < outputFrames; ++out)
+    {
+        const uint32_t sourcePosition = (static_cast<uint64_t>(out) * sampleRate) / 48000u;
+        const uint32_t sourceIndex = std::min(sourcePosition, frameCount - 1u);
+        const uint32_t nextIndex = std::min(sourceIndex + 1u, frameCount - 1u);
+        const uint32_t fraction = (static_cast<uint64_t>(out) * sampleRate) % 48000u;
+        for (uint32_t channel = 0u; channel < 2u; ++channel)
+        {
+            const uint32_t sourceChannel = channels == 1u ? 0u : channel;
+            const int32_t first = pcm[static_cast<size_t>(sourceIndex) * channels + sourceChannel];
+            const int32_t second = pcm[static_cast<size_t>(nextIndex) * channels + sourceChannel];
+            const int32_t interpolated = first + ((second - first) * static_cast<int32_t>(fraction)) / 48000;
+            m_impl->pcmQueue.push_back(static_cast<float>(interpolated) / 32768.0f);
+        }
+    }
+
+    constexpr size_t kMaxQueuedFloats = 48000u * 2u * 2u;
+    const size_t unreadFloats = m_impl->pcmQueue.size() - m_impl->pcmReadOffset;
+    if (unreadFloats > kMaxQueuedFloats)
+    {
+        const size_t drop = unreadFloats - kMaxQueuedFloats;
+        const size_t eraseCount = m_impl->pcmReadOffset + drop;
+        m_impl->pcmQueue.erase(m_impl->pcmQueue.begin(),
+                               m_impl->pcmQueue.begin() + static_cast<ptrdiff_t>(eraseCount));
+        m_impl->pcmReadOffset = 0u;
+    }
+    return true;
+}
+
+void PS2AudioBackend::renderPcmStream(void *buffer, uint32_t frames)
+{
+    if (!buffer)
+    {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(m_mutex);
+    float *output = static_cast<float *>(buffer);
+    const size_t availableFrames = m_impl->pcmQueue.size() - m_impl->pcmReadOffset;
+    const size_t copyFrames = std::min<size_t>(frames, availableFrames / 2u);
+    for (size_t frame = 0u; frame < copyFrames; ++frame)
+    {
+        const size_t source = m_impl->pcmReadOffset + frame * 2u;
+        output[frame * 2u] = m_impl->pcmQueue[source];
+        output[frame * 2u + 1u] = m_impl->pcmQueue[source + 1u];
+    }
+    for (size_t frame = copyFrames; frame < frames; ++frame)
+    {
+        output[frame * 2u] = 0.0f;
+        output[frame * 2u + 1u] = 0.0f;
+    }
+    m_impl->pcmReadOffset += copyFrames * 2u;
+    if (m_impl->pcmReadOffset == m_impl->pcmQueue.size())
+    {
+        m_impl->pcmQueue.clear();
+        m_impl->pcmReadOffset = 0u;
+    }
+    else if (m_impl->pcmReadOffset > 65536u)
+    {
+        m_impl->pcmQueue.erase(m_impl->pcmQueue.begin(), m_impl->pcmQueue.begin() + static_cast<ptrdiff_t>(m_impl->pcmReadOffset));
+        m_impl->pcmReadOffset = 0u;
+    }
+}
+
+void PS2AudioBackend::pcmStreamCallback(void *buffer, uint32_t frames)
+{
+    if (PS2AudioBackend *backend = g_pcmStreamBackend.load())
+    {
+        backend->renderPcmStream(buffer, frames);
+    }
+    else if (buffer)
+    {
+        std::memset(buffer, 0, static_cast<size_t>(frames) * 2u * sizeof(float));
+    }
+}
+
+void PS2AudioBackend::endPcmStream()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    stopPcmStreamUnlocked();
 }
 

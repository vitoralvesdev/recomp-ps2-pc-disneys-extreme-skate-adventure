+        std::deque<MpegPssAudioBlock> blocks;
+        size_t pos = 0u;
+        while (pos + 4u <= size)
+        {
+            if (pss[pos] != 0x00u || pss[pos + 1u] != 0x00u || pss[pos + 2u] != 0x01u)
+            {
+                ++pos;
+                continue;
+            }
+            const uint8_t streamId = pss[pos + 3u];
+            if (streamId == kMpegProgramEnd)

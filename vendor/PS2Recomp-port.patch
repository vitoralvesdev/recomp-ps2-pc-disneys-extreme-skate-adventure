+#ifndef PS2X_EXP_TRACE_H
+#define PS2X_EXP_TRACE_H
+
+// Diagnostic-only instrumentation for the four fidelity experiments.
+// Disabled unless DISNEY_EXPERIMENT is set to a comma separated list of
+// macro, collision, budget, vlqi (or "all"). Every hook is a no-op otherwise.
+// No guest state is read back into execution: values are only written to CSV.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <string>
+
+#if defined(_WIN32)
+#include <direct.h>
+#endif
+
+namespace Ps2Exp
+{
+    enum Mode : uint32_t
+    {
+        kMacro = 1u << 0,
+        kCollision = 1u << 1,
+        kBudget = 1u << 2,
+        kVlqi = 1u << 3,
+        kAll = 0xFFFFFFFFu
+    };
+
+    inline uint32_t modeBits()
+    {
+        static const uint32_t bits = []() -> uint32_t
+        {
+            const char *value = std::getenv("DISNEY_EXPERIMENT");
+            if (!value || !*value)
+                return 0u;
+            const std::string text(value);
+            if (text.find("all") != std::string::npos)
+                return kAll;
+            uint32_t result = 0u;
+            if (text.find("macro") != std::string::npos)
+                result |= kMacro;
+            if (text.find("collision") != std::string::npos)
+                result |= kCollision;
+            if (text.find("budget") != std::string::npos)
+                result |= kBudget;
+            if (text.find("vlqi") != std::string::npos)
+                result |= kVlqi;
+            return result;
+        }();
+        return bits;
+    }
+
+    inline bool on(uint32_t bit) { return (modeBits() & bit) != 0u; }
+
+    inline uint32_t maxRows()
+    {
+        static const uint32_t value = []() -> uint32_t
+        {
+            if (const char *env = std::getenv("DISNEY_EXPERIMENT_MAX"))
+            {
+                const long parsed = std::strtol(env, nullptr, 10);
+                if (parsed > 0)
+                    return static_cast<uint32_t>(parsed);
+            }
+            return 250000u;
+        }();
+        return value;
+    }
+
+    inline const char *outputDir()
+    {
+        static const char *dir = []() -> const char *
+        {
+            if (const char *env = std::getenv("DISNEY_EXPERIMENT_OUT"))
+                return env;
+            static std::string fallback = "analysis/experiments";
+#if defined(_WIN32)
+            _mkdir(fallback.c_str());
+#else
+            mkdir(fallback.c_str(), 0777);
+#endif
+            return fallback.c_str();
+        }();
+        return dir;
+    }
+
+    struct Stream
+    {
+        std::FILE *file = nullptr;
+        uint64_t rows = 0;
+        uint64_t skipped = 0;
+        const char *label = "";
+    };
+
+    inline void flushStream(Stream &s)
+    {
+        if (s.file)
+            std::fflush(s.file);
+    }
+
+    inline Stream &stream(Stream &s, const char *label, const char *header)
+    {
+        if (!s.file)
+        {
+            s.label = label;
+            char path[1024];
+            std::snprintf(path, sizeof(path), "%s/%s.csv", outputDir(), label);
+            s.file = std::fopen(path, "wb");
+            if (s.file)
+                std::fprintf(s.file, "%s\n", header);
+        }
+        return s;
+    }
+
+    inline bool admit(Stream &s)
+    {
+        if (!s.file)
+            return false;
+        if (s.rows >= maxRows())
+        {
+            ++s.skipped;
+            return false;
+        }
+        ++s.rows;
+        if ((s.rows & 63u) == 0u)
+            std::fflush(s.file);
+        return true;
+    }
+
+    inline void hexBytes(char out[33], const void *data)
+    {
+        const uint8_t *bytes = static_cast<const uint8_t *>(data);
+        static const char digits[] = "0123456789abcdef";
+        for (int i = 0; i < 16; ++i)
+        {
+            out[i * 2] = digits[bytes[i] >> 4];
+            out[i * 2 + 1] = digits[bytes[i] & 0xF];
+        }
+        out[32] = '\0';
+    }
+
+    inline void hexFloats(char out[37], const float values[4])
+    {
+        std::snprintf(out, 37, "%08x%08x%08x%08x",
+                      *reinterpret_cast<const uint32_t *>(&values[0]),
+                      *reinterpret_cast<const uint32_t *>(&values[1]),
+                      *reinterpret_cast<const uint32_t *>(&values[2]),
+                      *reinterpret_cast<const uint32_t *>(&values[3]));
+    }
+
+    // PCSX2 VU FPU reference semantics (see the report): SQRT is sqrt(fabs(x));
+    // DIV with a zero denominator yields signed FLT_MAX (0/0 keeps NaN).
+    inline float refSqrt(float value) { return std::sqrt(std::fabs(value)); }
+
+    inline float refDiv(float numerator, float denominator)
+    {
+        if (denominator == 0.0f)
+        {
+            if (numerator == 0.0f)
+                return std::numeric_limits<float>::quiet_NaN();
+            const bool negative = (std::signbit(numerator) != std::signbit(denominator));
+            return negative ? -3.402823466e+38f : 3.402823466e+38f;
+        }
+        return numerator / denominator;
+    }
+
+    // ---- Experiment 1: VU0 macro helpers -------------------------------------
+    // 0x2D2B90 normalizes *a1 into *a0 through VSQRT + VDIV (fs = vf0.w = 1).
+    // 0x2D2E20 evaluates a VSQRT over 1 - dot(v, v) (output vf4.x).
+    struct Streams
+    {
+        Stream macro;
+        Stream collision;
+        Stream budget;
+        Stream vlqi;
+        Stream runs;
+    };
+
+    inline Streams &streams()
+    {
+        static Streams instance;
+        return instance;
+    }
+
+    // Raw register snapshot at the two macro-mode helpers that contain VSQRT/VDIV.
+    // The independent reference replays the real instruction sequence offline.
+    inline void logMacro(uint32_t helper, uint32_t ra, uint32_t inPtr, uint32_t outPtr,
+                         const void *memIn16, const void *memOut16,
+                         const float qIn, const float in4[4], const float in5[4], const float in6[4],
+                         const float in7[4], const float in8[4],
+                         const float qOut, const float out4[4], const float out5[4], const float out6[4],
+                         const float out7[4], const float out8[4])
+    {
+        Stream &s = stream(streams().macro, "exp1-vu0-macro",
+                           "seq,helper,ra,in_ptr,out_ptr,mem_in,mem_out,q_in_hex,vf4_in,vf5_in,vf6_in,vf7_in,vf8_in,"
+                           "q_out_hex,vf4_out,vf5_out,vf6_out,vf7_out,vf8_out");
+        if (!admit(s))
+            return;
+        char inHex[5][37], outHex[5][37], memIn[33], memOut[33];
+        hexFloats(inHex[0], in4);
+        hexFloats(inHex[1], in5);
+        hexFloats(inHex[2], in6);
+        hexFloats(inHex[3], in7);
+        hexFloats(inHex[4], in8);
+        hexFloats(outHex[0], out4);
+        hexFloats(outHex[1], out5);
+        hexFloats(outHex[2], out6);
+        hexFloats(outHex[3], out7);
+        hexFloats(outHex[4], out8);
+        if (memIn16)
+            hexBytes(memIn, memIn16);
+        else
+            std::memset(memIn, '-', 32), memIn[32] = '\0';
+        if (memOut16)
+            hexBytes(memOut, memOut16);
+        else
+            std::memset(memOut, '-', 32), memOut[32] = '\0';
+        std::fprintf(s.file,
+                     "%llu,0x%08x,0x%08x,0x%08x,0x%08x,%s,%s,%08x,%s,%s,%s,%s,%s,%08x,%s,%s,%s,%s,%s\n",
+                     static_cast<unsigned long long>(s.rows), helper, ra, inPtr, outPtr,
+                     memIn, memOut,
+                     *reinterpret_cast<const uint32_t *>(&qIn),
+                     inHex[0], inHex[1], inHex[2], inHex[3], inHex[4],
+                     *reinterpret_cast<const uint32_t *>(&qOut),
+                     outHex[0], outHex[1], outHex[2], outHex[3], outHex[4]);
+    }
+
+    // ---- Experiment 2: collision kernel 0x7E8 --------------------------------
+    struct CollisionRow
+    {
+        uint32_t ra = 0;
+        uint32_t a0 = 0;
+        uint32_t a1 = 0;
+        float vf4[4]{};
+        float vf5[4]{};
+        float vf6[4]{};
+        float vf7[4]{};
+        float vf8[4]{};
+        uint16_t vi[16]{};
+        int16_t hit = 0;
+        float t = 0.0f;
+        float q = 0.0f;
+        uint32_t cycles = 0;
+        bool ended = false;
+        bool budgetHit = false;
+    };
+
+    inline void logCollision(const CollisionRow &row)
+    {
+        Stream &s = stream(streams().collision, "exp2-collision-7e8",
+                           "seq,ra,a0,a1,vf4_x,vf4_y,vf4_z,vf4_w,vf5_x,vf5_y,vf5_z,vf5_w,"
+                           "vf6_x,vf6_y,vf6_z,vf6_w,vf7_x,vf7_y,vf7_z,vf7_w,"
+                           "vf8_x,vf8_y,vf8_z,vf8_w,vi_hex,hit,vf17_x,q,cycles,ended,budget_hit");
+        if (!admit(s))
+            return;
+        char viHex[33];
+        std::snprintf(viHex, sizeof(viHex),
+                      "%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x%04x",
+                      row.vi[0], row.vi[1], row.vi[2], row.vi[3], row.vi[4], row.vi[5], row.vi[6], row.vi[7],
+                      row.vi[8], row.vi[9], row.vi[10], row.vi[11], row.vi[12], row.vi[13], row.vi[14], row.vi[15]);
+        std::fprintf(s.file,
+                     "%llu,0x%08x,0x%08x,0x%08x,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,"
+                     "%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,"
+                     "%.9g,%.9g,%.9g,%.9g,%s,%d,%.9g,%.9g,%u,%d,%d\n",
+                     static_cast<unsigned long long>(s.rows), row.ra, row.a0, row.a1,
+                     row.vf4[0], row.vf4[1], row.vf4[2], row.vf4[3],
+                     row.vf5[0], row.vf5[1], row.vf5[2], row.vf5[3],
+                     row.vf6[0], row.vf6[1], row.vf6[2], row.vf6[3],
+                     row.vf7[0], row.vf7[1], row.vf7[2], row.vf7[3],
+                     row.vf8[0], row.vf8[1], row.vf8[2], row.vf8[3],
+                     viHex, row.hit, row.t, row.q, row.cycles, row.ended ? 1 : 0, row.budgetHit ? 1 : 0);
+    }
+
+    // ---- Experiment 3: VU cycle budgets --------------------------------------
+    struct BudgetRow
+    {
+        const char *unit = "?";
+        uint32_t entryPc = 0;
+        uint32_t startCycle = 0;
+        uint32_t cyclesUsed = 0;
+        bool ended = false;
+        bool budgetHit = false;
+        bool ebit = false;
+        bool stoppedByD = false;
+        bool stoppedByT = false;
+        uint32_t vu0Tpc = 0;
+    };
+
+    inline void logBudget(const BudgetRow &row)
+    {
+        Stream &s = stream(streams().budget, "exp3-vu-budget",
+                           "seq,unit,entry_pc,start_cycle,cycles_used,ended,budget_hit,ebit,stop_d,stop_t,vu0_tpc");
+        if (!admit(s))
+            return;
+        std::fprintf(s.file, "%llu,%s,0x%08x,%u,%u,%d,%d,%d,%d,%d,0x%08x\n",
+                     static_cast<unsigned long long>(s.rows), row.unit, row.entryPc,
+                     row.startCycle, row.cyclesUsed, row.ended ? 1 : 0, row.budgetHit ? 1 : 0,
+                     row.ebit ? 1 : 0, row.stoppedByD ? 1 : 0, row.stoppedByT ? 1 : 0, row.vu0Tpc);
+    }
+
+    // ---- Experiment 4: VLQI/VSQI --------------------------------------------
+    inline void logVectorAccess(uint32_t sitePc, const char *kind, uint32_t viIndex, uint32_t viValue,
+                                uint32_t addr, const void *value16, const void *rdram16, const void *vuMem16)
+    {
+        Stream &s = stream(streams().vlqi, "exp4-vlqi-vsqi",
+                           "seq,site,kind,vi_index,vi_value,addr,value_hex,rdram_hex,vu0mem_hex,diverges");
+        if (!admit(s))
+            return;
+        char valueHex[33], rdramHex[33], vuMemHex[33];
+        hexBytes(valueHex, value16);
+        hexBytes(rdramHex, rdram16);
+        hexBytes(vuMemHex, vuMem16);
+        const bool diverges = std::memcmp(vuMem16, rdram16, 16u) != 0;
+        std::fprintf(s.file, "%llu,0x%08x,%s,%u,0x%08x,0x%08x,%s,%s,%s,%d\n",
+                     static_cast<unsigned long long>(s.rows), sitePc, kind, viIndex, viValue, addr,
+                     valueHex, rdramHex, vuMemHex, diverges ? 1 : 0);
+    }
+
+    // ---- Experiment 3 companion: VU run accounting ---------------------------
+    inline void logRun(const char *unit, uint32_t entryPc, uint32_t startCycle, uint32_t cycles,
+                       bool ended, bool budgetHit)
+    {
+        Stream &s = stream(streams().runs, "exp3-vu-runs",
+                           "seq,unit,entry_pc,start_cycle,cycles,ended,budget_hit");
+        if (!admit(s))
+            return;
+        std::fprintf(s.file, "%llu,%s,0x%08x,%u,%u,%d,%d\n",
+                     static_cast<unsigned long long>(s.rows), unit, entryPc, startCycle, cycles,
+                     ended ? 1 : 0, budgetHit ? 1 : 0);
+    }
+
+    inline void flushAll()
+    {
+        Streams &s = streams();
+        flushStream(s.macro);
+        flushStream(s.collision);
+        flushStream(s.budget);
+        flushStream(s.vlqi);
+        flushStream(s.runs);
+        if (s.macro.skipped || s.collision.skipped || s.budget.skipped || s.vlqi.skipped || s.runs.skipped)
+        {
+            std::fprintf(stderr,
+                         "[exp] truncated rows: macro=%llu collision=%llu budget=%llu vlqi=%llu runs=%llu\n",
+                         static_cast<unsigned long long>(s.macro.skipped),
+                         static_cast<unsigned long long>(s.collision.skipped),
+                         static_cast<unsigned long long>(s.budget.skipped),
+                         static_cast<unsigned long long>(s.vlqi.skipped),
+                         static_cast<unsigned long long>(s.runs.skipped));
+        }
+    }
+
+    inline void registerFlush()
+    {
+        static bool registered = false;
+        if (!registered)
+        {
+            registered = true;
+            std::atexit(flushAll);
+        }
+    }
+}
+
+#endif
diff --git a/ps2xRuntime/include/runtime/ps2_profile.h b/ps2xRuntime/include/runtime/ps2_profile.h
new file mode 100644
index 0000000..ef69aae
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_profile.h
@@ -0,0 +1,25 @@
+#pragma once
+// Cheap wall-clock counters for the host-side PS2 pipeline that runs inside
+// guest thread context: DMA chain processing, VIF1 unpack, GIF submission and
+// VU1 microprogram execution. Header-only inline atomics; zero cost unless a
+// session reads them.
+#include <atomic>
+#include <chrono>
+
+namespace Ps2Profile {
+inline std::atomic<unsigned long long> pendingNs{0};
+inline std::atomic<unsigned long long> vif1Ns{0};
+inline std::atomic<unsigned long long> gifNs{0};
+inline std::atomic<unsigned long long> vu1Ns{0}, vu1Jobs{0}, vu1Cycles{0};
+inline std::atomic<unsigned long long> gifBytes{0};
+inline std::atomic<unsigned long long> gsSubmits{0}, gsVertices{0};
+// Time inside the GIF path that builds and enqueues one primitive's draw batch (subset of gifNs).
+inline std::atomic<unsigned long long> gsVtxNs{0};
+
+template <class Sink> struct Timer {
+    std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+    Sink &sink;
+    explicit Timer(Sink &s) : sink(s) {}
+    ~Timer() { sink.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count(), std::memory_order_relaxed); }
+};
+}
diff --git a/ps2xRuntime/include/runtime/ps2_vu1_native.h b/ps2xRuntime/include/runtime/ps2_vu1_native.h
new file mode 100644
index 0000000..e2df852
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_vu1_native.h
@@ -0,0 +1,646 @@
+// DISNEY-Port: native VU1 backend (portado do backend do GOW, usado só como referência). Blocos básicos do
+// microcódigo de VU1 do jogo são traduzidos ahead-of-time (tools/vu1/vu1n_gen.py) para funções SSE diretas com
+// semântica imediata, sem tempo de ciclo: o VU entrelaça cada hazard, então os *valores* que um programa calcula
+// nunca dependem do tempo; só os registradores de flags MAC/CLIP têm latência visível, e o gerador preserva a
+// ordem deles. O motor exato (VU1Interpreter) fica como fallback para os blocos não traduzidos e como oráculo
+// do DISNEY_VU1N_VERIFY.
+#ifndef PS2_VU1_NATIVE_H
+#define PS2_VU1_NATIVE_H
+
+#include "runtime/ps2_vu1.h"
+
+#include <bit>
+#include <cfloat>
+#include <cmath>
+#include <cstdlib>
+#include <unordered_map>
+#include <vector>
+#include <cstdint>
+#include <cstring>
+#include <immintrin.h>
+
+class PS2Memory;
+
+namespace vu1n
+{
+    inline uint32_t macValRt(__m128 r, uint32_t m);
+}
+
+// The flag writers of a native block that only matter to a read less than kFmacLatency cycles after its exit: all MAC /
+// clip writers but the newest whose successor lies in the block's last three pairs (vu1n_gen.py). The descriptor is
+// static (pairs, DEST masks in SSE order); the block stores the values (MAC: the unclamped FMAC result) in its record.
+struct VU1TailDesc
+{
+    uint8_t macCount, clipCount;
+    uint8_t macPair[3], macMask[3], clipPair[3];
+};
+struct VU1FlagTail
+{
+    const VU1TailDesc *desc;
+    const uint8_t *cyc; // issue cycles of the block's pairs (relative to start)
+    uint64_t start;
+    __m128 q[3];
+    uint32_t c[3];
+};
+
+// MAC / clip flags while native blocks run: the last four writers (issue cycle, value) in slots 0-3 and, in slot 4, the
+// writer pushed out last (visible before them). The VU issues at most one FMAC / CLIP per cycle, so four writers cover
+// the whole latency window (kFmacLatency). A MAC writer pushed by a native block keeps its FMAC result (raw, DEST mask in
+// SSE order): the flags are computed only when something reads them; mask 0 = value holds the flags. A native block
+// pushes only its newest writer, with its tail record: the older writers there are visible before it.
+struct VU1FlagRing
+{
+    __m128 raw[5] = {};
+    uint64_t issue[4] = {};
+    uint32_t value[5] = {};
+    uint32_t mask[5] = {};
+    const VU1FlagTail *tail[5] = {};
+    uint32_t next = 0; // slot of the next push (the oldest writer)
+    bool clip = false;
+    void reset(uint32_t value0)
+    {
+        for (uint32_t k = 0; k < 5u; ++k)
+            value[k] = value0, mask[k] = 0u, tail[k] = nullptr;
+        for (uint32_t k = 0; k < 4u; ++k)
+            issue[k] = 0u;
+        next = 0u;
+    }
+    uint32_t valueOf(uint32_t k) const { return mask[k] ? vu1n::macValRt(raw[k], mask[k]) : value[k]; }
+    void evict()
+    {
+        raw[4] = raw[next];
+        value[4] = value[next];
+        mask[4] = mask[next];
+        tail[4] = tail[next];
+    }
+};
+
+struct VU1NativeCtx
+{
+    VU1State *s = nullptr;
+    uint8_t *data = nullptr;
+    uint32_t mask = 0u; // dataSize - 1
+    VU1Interpreter *vu = nullptr;
+    void *context = nullptr; // VU1Interpreter::StepContext *
+    const uint8_t *cyc = nullptr; // issue cycle of every pair of the running block, from the exact engine's stall model
+    uint64_t start = 0;           // exact-engine cycle at which the running block's pair 0 issues
+    VU1FlagRing *macRing = nullptr, *clipRing = nullptr;
+    VU1FlagTail *tail = nullptr; // the running block's tail record (blocks with a VU1TailDesc)
+};
+
+// Return value of a native block: next pc in the low 16 bits; kEnded when the program finished; kBail when the exact
+// engine must continue at the returned pc (D/T halt enabled, ...).
+constexpr uint32_t kVu1nEnded = 0x80000000u;
+constexpr uint32_t kVu1nBail = 0x40000000u;
+using VU1NativeFn = uint32_t (*)(VU1NativeCtx &);
+
+// Registered by the generated tables: key = FNV-1a over (pc, block words), see vu1n::blockKey. pairs: block length in the
+// low 16 bits, bit 16 set when the block reads MAC/clip flags written before it (it then needs exact entry timing).
+void vu1nRegisterBlock(uint64_t key, VU1NativeFn fn, uint32_t pairs, const VU1TailDesc *tail);
+
+struct VU1Interpreter::NativeState
+{
+    uint64_t generation = ~0ull;
+    // Exact issue cycles of a block from the pipeline state at its entry, so results and flags in flight from the previous
+    // block (native or exact) stall and become visible exactly as in the exact engine. Pipeline lanes: VF reg*4+comp
+    // (0-127), VI 128+reg, ACC 144+comp. While native blocks run, no per-lane state is kept: the recent blocks are
+    // remembered (`hist`) and a lane's ready cycle is derived from its newest writer only when a block that needs exact
+    // timing enters or the exact engine takes over (its readiness arrays are synced then).
+    static constexpr uint32_t kLanes = 148;
+    struct BlockTiming
+    {
+        std::vector<DecodedInstructionPair> dec;
+        uint64_t readMask[3] = {};   // lanes read before the block writes them
+        uint64_t writeMask[3] = {};  // lanes the block writes
+        uint8_t readAt[kLanes] = {}; // idle-schedule issue cycle of the first such read
+        uint8_t lastPair[kLanes] = {}, lastLat[kLanes] = {}; // last write of each written lane: pair and latency
+        uint8_t scalarRead = 0;      // bit 0 FDIV, 1 EFU unit, 2 WAITP read before the block starts one
+        uint8_t scalarAt[3] = {};
+        std::vector<uint8_t> scalarPairs; // pairs that start an FDIV / EFU operation
+        const uint8_t *idle = nullptr;
+        bool readsEntryFlags = false; // reads flags written before it: exact entry timing (others use `idle`)
+        struct Cached { std::vector<uint16_t> sig; std::vector<uint8_t> cyc; uint32_t id = 0; };
+        std::vector<Cached> cache; // timings for in-flight entry states seen so far (loops repeat the same few)
+        uint32_t next = 0;
+    };
+    std::unordered_map<uint64_t, BlockTiming> timings;
+    // Per pc slot, what the dispatch loop touches for every block (one cache line).
+    struct alignas(64) Slot
+    {
+        VU1NativeFn fn = nullptr; // null: no native block at this pc
+        const uint8_t *idle = nullptr;
+        BlockTiming *bt = nullptr;
+        // Entry timing by predecessor (blocks that read entry flags): when the block before ran for maxLat cycles or more
+        // and nothing from the exact engine is still in flight, that block and its timing table alone decide the entry
+        // state; the timing found for it is reused.
+        const BlockTiming *memoPred = nullptr;
+        const uint8_t *memoCyc = nullptr;
+        uint32_t memoPredId = 0, memoId = 0;
+        uint16_t pairs = 0;
+        bool known = false;
+        bool readsEntryFlags = false;
+        bool memoable = false;   // its entry timing does not depend on FDIV/EFU state
+        const VU1TailDesc *tail = nullptr;
+        uint8_t scalarCount = 0; // FDIV / EFU operations it starts (kScalarMany: more than fit in `scalar`)
+        struct Scalar { uint8_t pair, latency; bool fdiv; } scalar[2] = {};
+    };
+    static constexpr uint8_t kScalarMany = 0xFF;
+    Slot slots[2048];
+    // Native blocks run since native entry (or the last sync), newest last; histCount counts them all (the ring keeps the
+    // last kHist). A write is ready less than maxLat cycles after its block ended, so only blocks that ended less than
+    // maxLat cycles ago can still hold a lane in flight.
+    // cycId: 0 = the block's idle table, else the id of the cache slot (slots are reused, ids are not)
+    struct Hist { const BlockTiming *bt; const uint8_t *cyc; uint64_t start, end; uint32_t cycId; VU1FlagTail tail; };
+    static constexpr uint32_t kHist = 64;
+    Hist hist[kHist];
+    uint32_t histNext = 0, histCount = 0;
+    uint32_t maxLat = 0;
+    uint32_t nextCycId = 1;
+    // Every lane of the exact engine's readiness arrays is ready by arraysReadyBy (the arrays are cleared at every program
+    // start; recomputed at native entry when the exact engine ran since the last native exit at exitCycle).
+    uint64_t arraysReadyBy = 0, exitCycle = ~0ull;
+    std::vector<uint16_t> sig; // scratch: (lane << 8 | slack) of the in-flight lanes a block reads
+    using FlagRing = VU1FlagRing;
+    FlagRing macRing, clipRing;
+    bool flagsInRings = false; // the rings hold the flag state (set at native entry, cleared when the exact engine continues)
+    bool enabled = std::getenv("DISNEY_VU1_NATIVE_OFF") == nullptr;
+    unsigned verifyLeft = std::getenv("DISNEY_VU1N_VERIFY") ? static_cast<unsigned>(std::atoi(std::getenv("DISNEY_VU1N_VERIFY"))) : 0u;
+    bool diag = std::getenv("DISNEY_VU1N_DIAG") != nullptr;
+    unsigned long long nativePairs = 0, missBlocks = 0, nativeRuns = 0;
+    std::unordered_map<uint32_t, unsigned> missPcs, missHits;
+    unsigned limit = ~0u, count = 0; // verify bisection: native blocks allowed in this run
+    VU1State snap;                   // state on entry of block number `limit` (verify bisection)
+    std::vector<uint32_t> trace;     // pcs of the native blocks executed while bisecting
+};
+
+// Callouts into the exact engine for the rare instructions (defined in ps2_vu1_core.cpp).
+struct VU1NativeAccess
+{
+    // Flags across block boundaries, through the flag rings (cycle = start + rel): the MAC / clip value
+    // a reader issued at rel sees, the clip chain value CLIP shifts (newest, in flight included), and queueing a writer
+    // issued at rel (visible kFmacLatency later).
+    static uint32_t macAt(VU1NativeCtx &n, uint32_t rel);

+void GS::setPackedST(uint64_t lo, uint64_t hi)
+{
+    uint32_t sBits = static_cast<uint32_t>(lo & 0xFFFFFFFF);
+    uint32_t tBits = static_cast<uint32_t>((lo >> 32) & 0xFFFFFFFF);
+    uint32_t qBits = static_cast<uint32_t>(hi & 0xFFFFFFFF);

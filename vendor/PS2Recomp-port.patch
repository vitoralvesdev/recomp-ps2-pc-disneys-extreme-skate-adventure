+void PS2AudioBackend::stopPcmStreamUnlocked()
+{
+    PS2AudioBackend *expected = this;
+    g_pcmStreamBackend.compare_exchange_strong(expected, nullptr);
+    if (m_impl->pcmStreamActive)
